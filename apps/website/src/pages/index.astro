---
import { style } from "stillwind/astro";

import Snippet from "../components/Snippet.astro";
import ThemedPicture from "../components/ThemedPicture.astro";
import Layout from "../layouts/Layout.astro";
import { DOCS, NPM, promo, REPO, TAGLINE, TEMPLATE_REPO } from "../site.ts";

const brand = (theme: "light" | "dark", still: boolean) => `/brand/logo-${theme}${still ? ".still" : ""}.svg`;

const promptNew = `Make me an animated SVG with the template at ${TEMPLATE_REPO}.
Read its AGENTS.md first and follow it. Start by asking me what to make.`;

const promptExisting = `Read AGENTS.md and follow it to make me an animated SVG. Start by asking me what to make.`;

const promptPackage = `Add an animated SVG to this project with the svgreel npm package.
Install it, then read node_modules/svgreel/README.md and node_modules/svgreel/docs/rules.md
before writing a composition. Start by asking me what to make.`;

const install = `pnpm add svgreel react react-dom @fontsource/inter
pnpm svgreel build    # → dist/hello/hello.svg, dist/hello/hello.still.svg, dist/index.html`;

const composition = `import { charAnimations, defineComposition, fontsource, Text, useCurrentFrame, useVideoConfig } from "svgreel";

function Hello() {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  return (
    <svg viewBox="0 0 1200 400">
      <rect width={1200} height={400} fill="#0d1117" />
      <Text
        x={80}
        y={240}
        family="Inter"
        weight={800}
        size={120}
        fill="#e6edf3"
        charStyle={charAnimations.rise({ frame, fps, delay: 10 })}
      >
        Hello
      </Text>
    </svg>
  );
}

export default defineComposition({
  component: Hello,
  width: 1200,
  height: 400,
  fps: 30,
  durationInFrames: 90,
  fonts: fontsource("inter", { family: "Inter", weights: [800] }),
});`;

const embed = `<picture>
  <source media="(prefers-color-scheme: dark) and (not (prefers-reduced-motion: reduce))" srcset="./assets/banner-dark.svg" />
  <source media="(not (prefers-reduced-motion: reduce))" srcset="./assets/banner-light.svg" />
  <source media="(prefers-color-scheme: dark)" srcset="./assets/banner-dark.still.svg" />
  <img src="./assets/banner-light.still.svg" alt="Describe the banner here" width="100%" />
</picture>`;

const features = [
  ["Self-contained", "One SVG file: CSS keyframes for motion, glyph outlines for text. No JavaScript, no web fonts."],
  ["Works in a README", "GitHub shows it through a plain <img>. A still copy is built for reduced motion."],
  [
    "React, frame by frame",
    "A component gets the frame number and returns SVG. Sequences, springs and easing included.",
  ],
  ["Variants", "Dark and light themes, languages and your own axes, each built into its own file."],
] as const;

const docs = [
  ["rules.md", "What compositions may and may not do. Read this first."],
  ["api.md", "Components, animation helpers, fonts."],
  ["text.md", "How text becomes outlines, and its limits."],
  ["embedding.md", "Using the output in a README or elsewhere."],
  ["audio.md", "A sound track in the preview, and timing motion to music."],
  ["tools.md", "Optional scripts: video export, beat analysis."],
] as const;

const heading = style("m-0 text-2xl font-bold");
const lead = style("m-0 text-muted");
const note = style("m-0 text-muted text-sm");
const link = style("text-accent");
const inlineCode = style("font-mono text-sm");
const secondaryButton = style("px-4 py-2 text-foreground font-medium no-underline rounded-md border border-line", {
  "hover:": "bg-panel",
});
---

<Layout title="svgreel: animated SVGs from React components">
  <div {...style("flex mx-auto max-w-page px-6 py-16 flex-col gap-24")}>
    <header {...style("flex flex-col items-center gap-6 text-center")}>
      <h1 {...style("m-0")}>
        <ThemedPicture src={brand} alt="svgreel" width={240} height={84} />
      </h1>
      <p {...style("m-0 max-w-2xl text-xl/relaxed text-balance")}>{TAGLINE}</p>
      <p {...style(lead, "max-w-2xl text-balance")}>
        Profile banners, README headers and project showcases. Describe one to your AI agent, or write it yourself.
      </p>
      <nav {...style("flex flex-wrap justify-center gap-3")}>
        <a
          href="#agents"
          {...style("px-4 py-2 text-accent-foreground font-medium no-underline bg-accent rounded-md", {
            "hover:": "opacity-90",
          })}
        >
          Get started
        </a>
        <a href={REPO} {...style(secondaryButton)}>
          GitHub
        </a>
        <a href={NPM} {...style(secondaryButton)}>
          npm
        </a>
      </nav>
    </header>

    <ThemedPicture
      src={promo}
      alt="svgreel promo: write a React component where SVG = f(time), compile its frames into CSS keyframes, and get a self-contained animated SVG with outlined text, components, dark/light and language variants, and beat sync."
      width={1200}
      height={600}
      {...style("h-auto w-full rounded-xl border border-line")}
    />

    <ul {...style("grid m-0 p-0 gap-6 list-none sm:grid-cols-2")}>
      {features.map(([title, text]) => (
        <li {...style("flex flex-col gap-1")}>
          <h2 {...style("m-0 text-base font-semibold")}>{title}</h2>
          <p {...style(lead)}>{text}</p>
        </li>
      ))}
    </ul>

    <section id="agents" {...style("flex flex-col gap-6 scroll-mt-8")}>
      <div {...style("flex flex-col gap-2")}>
        <h2 {...style(heading)}>Make one with an AI agent</h2>
        <p {...style(lead)}>
          Paste a prompt into Claude Code, Codex, Cursor or a similar coding agent. The agent asks what you want, builds
          it, shows you a preview page, and changes it until you're happy.
        </p>
      </div>
      <Snippet
        title="Starting from nothing: the agent sets up your copy of the template"
        lang="text"
        code={promptNew}
      />
      <Snippet title="Inside your copy of the template" lang="text" code={promptExisting} />
      <Snippet title="Inside an existing project" lang="text" code={promptPackage} />
      <p {...style(note)}>
        The{" "}
        <a href={TEMPLATE_REPO} {...style(link)}>
          template
        </a>
        's AGENTS.md takes the agent through the questions, the build, the preview and publishing, and keeps notes in
        PROJECT.md for the next session. The package ships its docs and examples in{" "}
        <code {...style(inlineCode)}>node_modules/svgreel</code>, so agents read the version you installed.
      </p>
    </section>

    <section {...style("flex flex-col gap-6")}>
      <div {...style("flex flex-col gap-2")}>
        <h2 {...style(heading)}>Try the preview</h2>
        <p {...style(lead)}>
          Every build writes a preview page like this one next to the SVGs. These are the package's examples: play,
          scrub, step through frames, and switch backgrounds and variants.
        </p>
      </div>
      <iframe
        src="/examples/"
        title="svgreel preview with the package's examples"
        loading="lazy"
        {...style("h-200 w-full bg-panel rounded-xl border border-line")}
      ></iframe>
      <p {...style(note)}>
        <a href="/examples/" {...style(link)}>
          Open it in a full page
        </a>
        . Under <code {...style(inlineCode)}>svgreel build --watch</code>, it also has live controls for each
        composition's params.
      </p>
    </section>

    <section {...style("flex flex-col gap-6")}>
      <div {...style("flex flex-col gap-2")}>
        <h2 {...style(heading)}>Write it yourself</h2>
        <p {...style(lead)}>
          A composition is a React component: frame number in, SVG out. svgreel renders every frame, keeps only what
          changes, and compiles it into CSS keyframes.
        </p>
      </div>
      <Snippet title="compositions/hello/index.tsx" lang="tsx" code={composition} />
      <Snippet title="Terminal" lang="sh" code={install} />
      <p {...style(note)}>
        Requires Node.js 22.12+ and React 19. Compositions compile on the fly; your tsconfig.json needs{" "}
        <code {...style(inlineCode)}>"jsx": "react-jsx"</code>.
      </p>
    </section>

    <section {...style("flex flex-col gap-6")}>
      <div {...style("flex flex-col gap-2")}>
        <h2 {...style(heading)}>Put it in your README</h2>
        <p {...style(lead)}>
          Commit the files and reference them with relative paths. GitHub picks the file for the viewer's theme, and
          viewers who prefer reduced motion get the still. The preview's Embed code button writes this for you.
        </p>
      </div>
      <Snippet title="README.md" lang="html" code={embed} />
    </section>

    <section {...style("flex flex-col gap-6")}>
      <h2 {...style(heading)}>Docs</h2>
      <ul {...style("grid m-0 p-0 gap-3 list-none sm:grid-cols-2")}>
        {docs.map(([file, text]) => (
          <li>
            <a
              href={`${DOCS}/${file}`}
              {...style("flex h-full p-4 flex-col gap-1 text-foreground no-underline rounded-lg border border-line", {
                "hover:": "border-accent",
              })}
            >
              <span {...style("font-mono text-accent font-medium")}>{file}</span>
              <span {...style("text-muted text-sm")}>{text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <footer {...style("flex pt-8 flex-wrap justify-between gap-4 text-muted text-sm border-line border-t")}>
      <span>MIT licensed. The SVGs you make are yours.</span>
      <span {...style("flex gap-4")}>
        <a href={REPO} {...style("text-muted")}>
          GitHub
        </a>
        <a href={TEMPLATE_REPO} {...style("text-muted")}>
          Template
        </a>
        <a href={NPM} {...style("text-muted")}>
          npm
        </a>
      </span>
    </footer>
  </div>
</Layout>
